generator client {
  provider = "prisma-client-js"
}

enum VideoType {
  YOUTUBE
  ON_SITE
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum Role {
  STUDENT
  TEACHER
  ADMIN
  MANAGEMENT
  PARENT
}

enum TeacherRole {
  OWNER
  EDITOR
  VIEWER
}

//
// CENTER
//

model Center {
  id String @id @default(cuid())

  name String @unique
  slug String @unique
  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  classes Class[]
  subjects Subject[]
  teachers Teacher[]
  students Student[]
  admins Admin[]
  managements Management[]
  parents Parent[]
}

//
// USER
//

model User {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  role Role @default(STUDENT)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher    Teacher?
  student    Student?
  admin      Admin?
  management Management?
  parent     Parent?

  classAccesses               UserClassAccess[]
  subjectAccesses             UserSubjectAccess[]
  teacherSubjectAccesses      UserTeacherSubjectAccess[]
  assessmentResults           AssessmentResult[]
  assessmentReattemptRequests AssessmentReattemptRequest[]
  assessmentsModified         Assessment[] @relation("AssessmentLastModifiedBy")
  allowedClassesModified      AllowedClassesForAssessment[] @relation("AllowedClassLastModifiedBy")
  assessmentAttendances       AssessmentAttendance[]
  assessmentAttendancesMarked AssessmentAttendance[] @relation("AssessmentAttendanceMarkedBy")
}

model AppSetting {
  id String @id @default(cuid())

  key String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// CLASS
//

model Class {
  id String @id @default(cuid())

  className String  @unique @map("class_name")
  icon      String?

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subjects              Subject[]
  userAccesses          UserClassAccess[]
  assessments          Assessment[]
  allowedClasses        AllowedClassesForAssessment[]
}

//
// SUBJECT
//

model Subject {
  id String @id @default(cuid())

  subjectName String @map("subject_name")

  icon String?

  // FK
  classId String @map("class_id")
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacherSubjects TeacherSubject[]
  userAccesses    UserSubjectAccess[]
  chapters        Chapter[]
  assessments     Assessment[]

  @@unique([classId, subjectName])
}

//
// TEACHER
//

model Teacher {
  id String @id @default(cuid())

  // Link with User
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  name    String
  phone   String?
  address String?
  gender  String?
  dob     DateTime?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacherSubjects TeacherSubject[]
}

model Student {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  dob     DateTime?
  gender  String?
  phone   String?
  address String?
  schoolName    String?
  studyingClass String?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  dob     DateTime?
  gender  String?
  phone   String?
  address String?
  schoolName    String?
  studyingClass String?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Management {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  dob     DateTime?
  gender  String?
  phone   String?
  address String?
  schoolName    String?
  studyingClass String?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parent {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  dob     DateTime?
  gender  String?
  phone   String?
  address String?
  schoolName    String?
  studyingClass String?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// TEACHER SUBJECT
//

model TeacherSubject {
  id String @id @default(cuid())

  teacherId String @map("teacher_id")
  subjectId String @map("subject_id")

  role TeacherRole @default(OWNER)

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  userAccesses UserTeacherSubjectAccess[]

  @@unique([teacherId, subjectId])
}

//
// STUDENT CLASS ACCESS
//

model UserClassAccess {
  id String @id @default(cuid())

  userId  String @map("user_id")
  classId String @map("class_id")

  status Boolean @default(true)

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
}

//
// STUDENT SUBJECT ACCESS
//

model UserSubjectAccess {
  id String @id @default(cuid())

  userId    String @map("user_id")
  subjectId String @map("subject_id")

  status Boolean @default(true)

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

//
// STUDENT TEACHER CONTENT ACCESS
//

model UserTeacherSubjectAccess {
  id String @id @default(cuid())

  userId           String @map("user_id")
  teacherSubjectId String @map("teacher_subject_id")

  status Boolean @default(true)

  createdAt DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherSubject TeacherSubject @relation(fields: [teacherSubjectId], references: [id], onDelete: Cascade)

  @@unique([userId, teacherSubjectId])
}

model Chapter {
  id String @id @default(cuid())

  // FK
  subjectId String  @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  chapterName String @map("chapter_name")

  displayOrder Int @default(1) @map("display_order")

  status Boolean @default(true)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contents ChapterContent[]
  assessments Assessment[]

  @@unique([subjectId, chapterName])
  @@map("chapters")
}

enum AssessmentType {
  ASSESSMENT
  ASSIGNMENT
}

enum AssessmentReattemptStatus {
  PENDING
  APPROVED
  REJECTED
}

model Assessment {
  id String @id @default(cuid())

  classId String @map("class_id")
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Optional Subject
  subjectId String?  @map("subject_id")
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Optional Chapter
  chapterId String?  @map("chapter_id")
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  title String
  description String? @db.Text
  type AssessmentType @default(ASSESSMENT)
  totalMarks Int @default(0) @map("total_marks")
  gradeBands String? @db.Text @map("grade_bands")

  status Boolean @default(true)

  lastModifiedBy String? @map("last_modified_user")
  lastModifiedUser User? @relation("AssessmentLastModifiedBy", fields: [lastModifiedBy], references: [id], onDelete: SetNull)
  lastModifiedAt DateTime? @map("last_modified_time")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions AssessmentQuestion[]
  results AssessmentResult[]
  reattemptRequests AssessmentReattemptRequest[]
  allowedClasses AllowedClassesForAssessment[]
  attendances AssessmentAttendance[]

  @@index([classId])
  @@index([subjectId])
  @@index([chapterId])

  @@map("assessments")
}

model AllowedClassesForAssessment {
  id String @id @default(cuid())

  assessmentId String @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  classId String @map("class_id")
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  active Boolean @default(true) @map("active")

  lastModifiedBy String? @map("last_modified_user")
  lastModifiedUser User? @relation("AllowedClassLastModifiedBy", fields: [lastModifiedBy], references: [id], onDelete: SetNull)
  lastModifiedAt DateTime? @map("last_modified_time")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, classId])
  @@index([assessmentId])
  @@index([classId])
  @@map("allowed_classes_for_assessment")
}

model AssessmentQuestion {
  id String @id @default(cuid())

  assessmentId String @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  questionText String @map("question_text") @db.Text
  marks Int @default(1)
  displayOrder Int @default(1) @map("display_order")
  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options AssessmentOption[]

  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentOption {
  id String @id @default(cuid())

  questionId String @map("question_id")
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText String @map("option_text")
  isCorrect Boolean @default(false) @map("is_correct")
  displayOrder Int @default(1) @map("display_order")
  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@map("assessment_options")
}

model AssessmentResult {
  id String @id @default(cuid())

  assessmentId String @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  score Int @default(0)
  totalQuestions Int @default(0) @map("total_questions")
  totalMarks Int @default(0) @map("total_marks")
  percentage Int @default(0)
  grade String?
  answers String? @db.Text

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([userId])
  @@map("assessment_results")
}

model AssessmentReattemptRequest {
  id String @id @default(cuid())

  assessmentId String @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status AssessmentReattemptStatus @default(PENDING)
  reason String? @db.Text

  requestedAt DateTime @default(now()) @map("requested_at")
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy String? @map("reviewed_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([userId])
  @@index([status])
  @@map("assessment_reattempt_requests")
}

enum AssessmentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model AssessmentAttendance {
  id String @id @default(cuid())

  assessmentId String @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status AssessmentAttendanceStatus @default(PRESENT)
  reason String? @db.Text

  markedBy String? @map("marked_by")
  markedByUser User? @relation("AssessmentAttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: SetNull)

  markedAt DateTime? @map("marked_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
  @@index([status])
  @@map("assessment_attendances")
}

enum ContentType {
  NOTE
  VIDEO
  PDF
  PPT
  PREVIOUS_PAPER

  // Future
  ASSIGNMENT
  QUIZ
  LIVE_CLASS
  AUDIO
  EXTERNAL_LINK
}

model ChapterContent {
  id String @id @default(cuid())

  // FK
  chapterId String  @map("chapter_id")
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  type ContentType

  title String

  description String? @db.Text

  displayOrder Int @default(1) @map("display_order")

  isFree Boolean @default(false) @map("is_free")

  status Boolean @default(true)

  createdBy  String? @map("created_by")
  modifiedBy String? @map("modified_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note          ChapterNote?
  video         ChapterVideo?
  pdf           ChapterPdf?
  ppt           ChapterPpt?
  previousPaper ChapterPreviousPaper?

  @@index([chapterId])
  @@index([chapterId, displayOrder])
  @@map("chapter_contents")
}

model ChapterNote {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  notes String @db.Text

  @@map("chapter_notes")
}

model ChapterVideo {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  videoType VideoType @default(YOUTUBE) @map("video_type")

  videoLink String? @map("video_link")

  videoPath String? @map("video_path")

  thumbnail String?

  duration Int?

  @@map("chapter_videos")
}

model ChapterPdf {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  fileName String @map("file_name")

  filePath String @map("file_path")

  fileSize Int? @map("file_size")

  @@map("chapter_pdfs")
}

model ChapterPpt {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  fileName String @map("file_name")

  filePath String @map("file_path")

  fileSize Int? @map("file_size")

  @@map("chapter_ppts")
}

model ChapterPreviousPaper {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  fileName String @map("file_name")

  filePath String @map("file_path")

  fileSize Int? @map("file_size")

  @@map("chapter_previous_papers")
}
