generator client {
  provider = "prisma-client-js"
}

enum VideoType {
  YOUTUBE
  ON_SITE
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum Role {
  STUDENT
  TEACHER
  ADMIN
  MANAGEMENT
  PARENT
}

enum TeacherRole {
  OWNER
  EDITOR
  VIEWER
}

enum AssetCondition {
  GOOD
  FAIR
  NEEDS_REPAIR
  DAMAGED
}

enum AssetLifecycle {
  AVAILABLE
  UNDER_REPAIR
  DISPOSED
}

enum AssetTransferStatus {
  PENDING
  RECEIVED
  REJECTED
  CANCELLED
}

enum AssetEventType {
  PURCHASED
  UPDATED
  TRANSFER_REQUESTED
  TRANSFER_RECEIVED
  TRANSFER_REJECTED
  TRANSFER_CANCELLED
  SPLIT
  SENT_FOR_REPAIR
  RETURNED_FROM_REPAIR
  DISPOSED
}

//
// CENTER
//

model Center {
  id String @id @default(cuid())

  name   String  @unique
  slug   String  @unique
  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  classes            Class[]
  subjects           Subject[]
  teachers           Teacher[]
  students           Student[]
  admins             Admin[]
  managements        Management[]
  parents            Parent[]
  studentAttendances StudentAttendance[]
  teacherAttendances TeacherAttendance[]
  managementAttendances ManagementAttendance[]
  assessments316     Assessment316[]
  accessAssignments  UserAccessAssignmentCenter[]
  assetRecords       AssetList[]
}

//
// USER
//

model User {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  role Role @default(STUDENT)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher    Teacher?
  student    Student?
  admin      Admin?
  management Management?
  parent     Parent?

  classAccesses               UserClassAccess[]
  subjectAccesses             UserSubjectAccess[]
  teacherSubjectAccesses      UserTeacherSubjectAccess[]
  accessAssignment            UserAccessAssignment?
  assessmentResults            AssessmentResult[]
  assessmentReattemptRequests  AssessmentReattemptRequest[]
  assessmentsModified          Assessment[]                  @relation("AssessmentLastModifiedBy")
  allowedClassesModified       AllowedClassesForAssessment[] @relation("AllowedClassLastModifiedBy")
  assessmentAttendances        AssessmentAttendance[]
  assessmentAttendancesMarked  AssessmentAttendance[]        @relation("AssessmentAttendanceMarkedBy")
  assessment316Responses       Assessment316Response[]
  assessment316Attendances     Assessment316Attendance[]
  assessment316AttendancesMarked Assessment316Attendance[]    @relation("Assessment316AttendanceMarkedBy")
  studentAttendances           StudentAttendance[]
  studentAttendancesMarked     StudentAttendance[]           @relation("StudentAttendanceMarker")
}

model AppSetting {
  id String @id @default(cuid())

  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  codePrefix  String       @unique @map("code_prefix")
  codeCounter Int          @default(0) @map("code_counter")
  description String?      @db.Text
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       ItemMaster[]

  @@map("item_categories")
}

model ItemMaster {
  id           String      @id @default(cuid())
  name         String
  categoryId   String      @map("category_id")
  category     ItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description  String?     @db.Text
  unit         String      @default("unit")
  manufacturer String?
  modelNumber  String?     @map("model_number")
  status       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  assets       AssetList[]

  @@unique([categoryId, name])
  @@index([categoryId, status])
  @@map("item_masters")
}

model AssetList {
  id           String         @id @default(cuid())
  itemMasterId String         @map("item_master_id")
  itemMaster   ItemMaster     @relation(fields: [itemMasterId], references: [id], onDelete: Restrict)
  centerId     String         @map("center_id")
  center       Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  assetCode    String         @unique @map("asset_code")
  quantity     Int            @default(1)
  assetTag     String?        @unique @map("asset_tag")
  serialNumber String?        @map("serial_number")
  condition    AssetCondition @default(GOOD)
  lifecycle    AssetLifecycle @default(AVAILABLE)
  parentAssetId String?       @map("parent_asset_id")
  location     String?
  purchaseDate DateTime?      @map("purchase_date")
  purchaseCost Decimal?       @map("purchase_cost") @db.Decimal(12, 2)
  vendor       String?
  invoiceNumber String?       @map("invoice_number")
  warrantyExpiry DateTime?    @map("warranty_expiry")
  notes        String?        @db.Text
  status       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  events       AssetEvent[]
  transfers    AssetTransfer[]

  @@unique([itemMasterId, serialNumber])
  @@index([centerId, status])
  @@index([itemMasterId, status])
  @@index([serialNumber])
  @@map("asset_list")
}

model AssetTransfer {
  id               String              @id @default(cuid())
  transferNo       String              @unique @map("transfer_no")
  assetId          String              @map("asset_id")
  asset            AssetList           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  fromCenterId     String              @map("from_center_id")
  toCenterId       String              @map("to_center_id")
  quantity         Int
  status           AssetTransferStatus @default(PENDING)
  remarks          String?             @db.Text
  requestedById    String              @map("requested_by_id")
  respondedById    String?             @map("responded_by_id")
  respondedAt      DateTime?           @map("responded_at")
  responseRemarks  String?             @map("response_remarks") @db.Text
  resultingAssetId String?             @map("resulting_asset_id")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([fromCenterId, status])
  @@index([toCenterId, status])
  @@index([assetId, status])
  @@map("asset_transfers")
}

model AssetEvent {
  id           String         @id @default(cuid())
  assetId      String         @map("asset_id")
  asset        AssetList      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type         AssetEventType
  centerId     String?        @map("center_id")
  fromCenterId String?        @map("from_center_id")
  toCenterId   String?        @map("to_center_id")
  quantity     Int?
  remarks      String?        @db.Text
  performedById String?       @map("performed_by_id")
  referenceNo  String?        @map("reference_no")
  vendor       String?
  cost         Decimal?       @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())

  @@index([assetId, createdAt])
  @@map("asset_events")
}

model CustomRole {
  id          String                @id
  name        String                @unique
  description String                @default("") @db.Text
  status      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  permissions CustomRolePermission[]
  assignments UserAccessAssignment[]

  @@map("custom_roles")
}

model Permission {
  id          String                @id @default(cuid())
  key         String                @unique @map("permission_key")
  label       String
  category    String
  description String?               @db.Text
  status      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  roles       CustomRolePermission[]

  @@index([category, label])
  @@map("permissions")
}

model CustomRolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserAccessAssignment {
  userId    String                       @id @map("user_id")
  roleId    String?                      @map("role_id")
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CustomRole?                  @relation(fields: [roleId], references: [id], onDelete: SetNull)
  centers   UserAccessAssignmentCenter[]

  @@index([roleId])
  @@map("user_access_assignments")
}

model UserAccessAssignmentCenter {
  userId     String               @map("user_id")
  centerId   String               @map("center_id")
  assignment UserAccessAssignment @relation(fields: [userId], references: [userId], onDelete: Cascade)
  center     Center               @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@id([userId, centerId])
  @@index([centerId])
  @@map("user_access_assignment_centers")
}

//
// CLASS
//

model Class {
  id String @id @default(cuid())

  className String  @unique @map("class_name")
  icon      String?

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subjects           Subject[]
  userAccesses       UserClassAccess[]
  assessments        Assessment[]
  allowedClasses     AllowedClassesForAssessment[]
  assessments316     Assessment316Class[]
  studentAttendances StudentAttendance[]
}

//
// SUBJECT
//

model Subject {
  id String @id @default(cuid())

  subjectName String @map("subject_name")

  icon String?

  // FK
  classId String @map("class_id")
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacherSubjects TeacherSubject[]
  userAccesses    UserSubjectAccess[]
  chapters        Chapter[]
  assessments     Assessment[]
  assessments316  Assessment316Subject[]

  @@unique([classId, subjectName])
}

//
// TEACHER
//

model Teacher {
  id String @id @default(cuid())

  // Link with User
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  name    String
  phone   String?
  address String?
  gender  String?
  dob     DateTime?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacherSubjects TeacherSubject[]
  attendances     TeacherAttendance[]
}

model Student {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  dob           DateTime?
  gender        String?
  phone         String?
  address       String?
  schoolName    String?
  studyingClass String?
  teaGarden     String?
  fatherName    String?  @map("guardianName")
  motherName    String?  @map("mother_name")
  identityKey   String?  @unique @map("identity_key")

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  dob           DateTime?
  gender        String?
  phone         String?
  address       String?
  schoolName    String?
  studyingClass String?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Management {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  dob           DateTime?
  gender        String?
  phone         String?
  address       String?
  schoolName    String?
  studyingClass String?

  attendances ManagementAttendance[]

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parent {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  dob           DateTime?
  gender        String?
  phone         String?
  address       String?
  schoolName    String?
  studyingClass String?

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// TEACHER SUBJECT
//

model TeacherSubject {
  id String @id @default(cuid())

  teacherId String @map("teacher_id")
  subjectId String @map("subject_id")

  role TeacherRole @default(OWNER)

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  userAccesses UserTeacherSubjectAccess[]

  @@unique([teacherId, subjectId])
}

//
// STUDENT CLASS ACCESS
//

model UserClassAccess {
  id String @id @default(cuid())

  userId  String @map("user_id")
  classId String @map("class_id")

  status Boolean @default(true)

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
}

//
// STUDENT SUBJECT ACCESS
//

model UserSubjectAccess {
  id String @id @default(cuid())

  userId    String @map("user_id")
  subjectId String @map("subject_id")

  status Boolean @default(true)

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

//
// STUDENT TEACHER CONTENT ACCESS
//

model UserTeacherSubjectAccess {
  id String @id @default(cuid())

  userId           String @map("user_id")
  teacherSubjectId String @map("teacher_subject_id")

  status Boolean @default(true)

  createdAt DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherSubject TeacherSubject @relation(fields: [teacherSubjectId], references: [id], onDelete: Cascade)

  @@unique([userId, teacherSubjectId])
}

model Chapter {
  id String @id @default(cuid())

  // FK
  subjectId String  @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  chapterName String @map("chapter_name")

  displayOrder Int @default(1) @map("display_order")

  status Boolean @default(true)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contents    ChapterContent[]
  assessments Assessment[]

  @@unique([subjectId, chapterName])
  @@map("chapters")
}

enum AssessmentType {
  ASSESSMENT
  ASSIGNMENT
}

enum AssessmentReattemptStatus {
  PENDING
  APPROVED
  REJECTED
}

model Assessment316 {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text

  centerId String? @map("center_id")
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allowedClasses Assessment316Class[]
  subjects       Assessment316Subject[]
  checklist      Assessment316ChecklistItem[]
  responses      Assessment316Response[]
  attendances    Assessment316Attendance[]

  @@index([centerId])
  @@map("assessments_3_16")
}

model Assessment316Class {
  id           String        @id @default(cuid())
  assessmentId String        @map("assessment_id")
  assessment   Assessment316 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  classId      String        @map("class_id")
  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([assessmentId, classId])
  @@index([classId])
  @@map("assessment_3_16_classes")
}

model Assessment316Subject {
  id           String        @id @default(cuid())
  assessmentId String        @map("assessment_id")
  assessment   Assessment316 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  subjectId    String        @map("subject_id")
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([assessmentId, subjectId])
  @@index([subjectId])
  @@map("assessment_3_16_subjects")
}

model Assessment316ChecklistItem {
  id           String        @id @default(cuid())
  assessmentId String        @map("assessment_id")
  assessment   Assessment316 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  itemText     String        @map("item_text") @db.Text
  displayOrder Int           @default(1) @map("display_order")
  status       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  options      Assessment316ChecklistOption[]
  responseItems Assessment316ResponseItem[]

  @@index([assessmentId])
  @@map("assessment_3_16_checklist_items")
}

model Assessment316ChecklistOption {
  id            String                    @id @default(cuid())
  checklistId   String                    @map("checklist_id")
  checklist     Assessment316ChecklistItem @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  optionText    String                    @map("option_text")
  displayOrder  Int                       @default(1) @map("display_order")
  status        Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  responseItems Assessment316ResponseItem[]

  @@index([checklistId])
  @@map("assessment_3_16_checklist_options")
}

model Assessment316Response {
  id           String                    @id @default(cuid())
  assessmentId String                    @map("assessment_id")
  assessment   Assessment316             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String                    @map("user_id")
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       Boolean                   @default(true)
  submittedAt  DateTime                  @default(now()) @map("submitted_at")
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  items        Assessment316ResponseItem[]

  @@unique([assessmentId, userId])
  @@index([userId])
  @@map("assessment_3_16_responses")
}

enum Assessment316AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Assessment316Attendance {
  id           String                        @id @default(cuid())
  assessmentId String                        @map("assessment_id")
  assessment   Assessment316                 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String                        @map("user_id")
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       Assessment316AttendanceStatus @default(PRESENT)
  reason       String?                       @db.Text

  markedBy     String? @map("marked_by")
  markedByUser User?   @relation("Assessment316AttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: SetNull)

  markedAt     DateTime? @map("marked_at")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
  @@index([status])
  @@map("assessment_3_16_attendances")
}

model Assessment316ResponseItem {
  id          String                    @id @default(cuid())
  responseId  String                    @map("response_id")
  response    Assessment316Response    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  checklistId String                    @map("checklist_id")
  checklist   Assessment316ChecklistItem @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  optionId    String                    @map("option_id")
  option      Assessment316ChecklistOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([responseId, checklistId])
  @@index([optionId])
  @@map("assessment_3_16_response_items")
}

model Assessment {
  id String @id @default(cuid())

  classId String @map("class_id")
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Optional Subject
  subjectId String?  @map("subject_id")
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Optional Chapter
  chapterId String?  @map("chapter_id")
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  title       String
  description String?        @db.Text
  type        AssessmentType @default(ASSESSMENT)
  totalMarks  Int            @default(0) @map("total_marks")
  gradeBands  String?        @map("grade_bands") @db.Text

  status Boolean @default(true)

  lastModifiedBy   String?   @map("last_modified_user")
  lastModifiedUser User?     @relation("AssessmentLastModifiedBy", fields: [lastModifiedBy], references: [id], onDelete: SetNull)
  lastModifiedAt   DateTime? @map("last_modified_time")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions         AssessmentQuestion[]
  results           AssessmentResult[]
  reattemptRequests AssessmentReattemptRequest[]
  allowedClasses    AllowedClassesForAssessment[]
  attendances       AssessmentAttendance[]

  @@index([classId])
  @@index([subjectId])
  @@index([chapterId])
  @@map("assessments")
}

model AllowedClassesForAssessment {
  id String @id @default(cuid())

  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  classId String @map("class_id")
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  active Boolean @default(true) @map("active")

  lastModifiedBy   String?   @map("last_modified_user")
  lastModifiedUser User?     @relation("AllowedClassLastModifiedBy", fields: [lastModifiedBy], references: [id], onDelete: SetNull)
  lastModifiedAt   DateTime? @map("last_modified_time")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, classId])
  @@index([assessmentId])
  @@index([classId])
  @@map("allowed_classes_for_assessment")
}

model AssessmentQuestion {
  id String @id @default(cuid())

  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  questionText String  @map("question_text") @db.Text
  questionDesc String? @map("question_desc") @db.Text
  marks        Int     @default(1)
  displayOrder Int     @default(1) @map("display_order")
  status       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options AssessmentOption[]

  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentOption {
  id String @id @default(cuid())

  questionId String             @map("question_id")
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText   String  @map("option_text")
  isCorrect    Boolean @default(false) @map("is_correct")
  displayOrder Int     @default(1) @map("display_order")
  status       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@map("assessment_options")
}

model AssessmentResult {
  id String @id @default(cuid())

  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score          Int     @default(0)
  totalQuestions Int     @default(0) @map("total_questions")
  totalMarks     Int     @default(0) @map("total_marks")
  percentage     Int     @default(0)
  grade          String?
  answers        String? @db.Text

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([userId])
  @@map("assessment_results")
}

model AssessmentReattemptRequest {
  id String @id @default(cuid())

  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status AssessmentReattemptStatus @default(PENDING)
  reason String?                   @db.Text

  requestedAt DateTime  @default(now()) @map("requested_at")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?   @map("reviewed_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([userId])
  @@index([status])
  @@map("assessment_reattempt_requests")
}

enum AssessmentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  HOLIDAY
  WEEKLY_OFF
}

model StudentAttendance {
  id String @id @default(cuid())

  attendanceDate DateTime @map("attendance_date") @db.Date
  studentId      String   @map("student_id")
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  centerId String @map("center_id")
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  classId String @map("class_id")
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  status   StudentAttendanceStatus
  markedBy String?                 @map("marked_by")
  marker   User?                   @relation("StudentAttendanceMarker", fields: [markedBy], references: [id], onDelete: SetNull)
  markedAt DateTime                @default(now()) @map("marked_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceDate, studentId])
  @@index([attendanceDate, centerId, classId])
  @@index([studentId])
  @@map("student_attendances")
}

model TeacherAttendance {
  id             String   @id @default(cuid())
  attendanceDate DateTime @map("attendance_date") @db.Date
  teacherId      String   @map("teacher_id")
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  centerId       String?  @map("center_id")
  center         Center?  @relation(fields: [centerId], references: [id], onDelete: SetNull)

  checkInAt                 DateTime? @map("check_in_at")
  checkInLatitude           Decimal?  @map("check_in_latitude") @db.Decimal(9, 6)
  checkInLongitude          Decimal?  @map("check_in_longitude") @db.Decimal(9, 6)
  checkInAccuracyMeters     Decimal?  @map("check_in_accuracy_meters") @db.Decimal(8, 2)
  checkOutAt                DateTime? @map("check_out_at")
  checkOutLatitude          Decimal?  @map("check_out_latitude") @db.Decimal(9, 6)
  checkOutLongitude         Decimal?  @map("check_out_longitude") @db.Decimal(9, 6)
  checkOutAccuracyMeters    Decimal?  @map("check_out_accuracy_meters") @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceDate, teacherId])
  @@index([attendanceDate, centerId])
  @@map("teacher_attendances")
}

model ManagementAttendance {
  id             String     @id @default(cuid())
  attendanceDate DateTime   @map("attendance_date") @db.Date
  managementId   String     @map("management_id")
  management     Management @relation(fields: [managementId], references: [id], onDelete: Cascade)
  centerId       String?    @map("center_id")
  center         Center?    @relation(fields: [centerId], references: [id], onDelete: SetNull)

  checkInAt              DateTime? @map("check_in_at")
  checkInLatitude        Decimal?  @map("check_in_latitude") @db.Decimal(9, 6)
  checkInLongitude       Decimal?  @map("check_in_longitude") @db.Decimal(9, 6)
  checkInAccuracyMeters  Decimal?  @map("check_in_accuracy_meters") @db.Decimal(8, 2)
  checkOutAt             DateTime? @map("check_out_at")
  checkOutLatitude       Decimal?  @map("check_out_latitude") @db.Decimal(9, 6)
  checkOutLongitude      Decimal?  @map("check_out_longitude") @db.Decimal(9, 6)
  checkOutAccuracyMeters Decimal?  @map("check_out_accuracy_meters") @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceDate, managementId])
  @@index([attendanceDate, centerId])
  @@map("management_attendances")
}

model AssessmentAttendance {
  id String @id @default(cuid())

  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status AssessmentAttendanceStatus @default(PRESENT)
  reason String?                    @db.Text

  markedBy     String? @map("marked_by")
  markedByUser User?   @relation("AssessmentAttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: SetNull)

  markedAt DateTime? @map("marked_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
  @@index([status])
  @@map("assessment_attendances")
}

enum ContentType {
  NOTE
  VIDEO
  PDF
  PPT
  PREVIOUS_PAPER

  // Future
  ASSIGNMENT
  QUIZ
  LIVE_CLASS
  AUDIO
  EXTERNAL_LINK
}

model ChapterContent {
  id String @id @default(cuid())

  // FK
  chapterId String  @map("chapter_id")
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  type ContentType

  title String

  description String? @db.Text

  displayOrder Int @default(1) @map("display_order")

  isFree Boolean @default(false) @map("is_free")

  status Boolean @default(true)

  createdBy  String? @map("created_by")
  modifiedBy String? @map("modified_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note          ChapterNote?
  video         ChapterVideo?
  pdf           ChapterPdf?
  ppt           ChapterPpt?
  previousPaper ChapterPreviousPaper?

  @@index([chapterId])
  @@index([chapterId, displayOrder])
  @@map("chapter_contents")
}

model ChapterNote {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  notes String @db.Text

  @@map("chapter_notes")
}

model ChapterVideo {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  videoType VideoType @default(YOUTUBE) @map("video_type")

  videoLink String? @map("video_link")

  videoPath String? @map("video_path")

  thumbnail String?

  duration Int?

  @@map("chapter_videos")
}

model ChapterPdf {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  fileName String @map("file_name")

  filePath String @map("file_path")

  fileSize Int? @map("file_size")

  @@map("chapter_pdfs")
}

model ChapterPpt {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  fileName String @map("file_name")

  filePath String @map("file_path")

  fileSize Int? @map("file_size")

  @@map("chapter_ppts")
}

model ChapterPreviousPaper {
  id String @id @default(cuid())

  contentId String         @unique @map("content_id")
  content   ChapterContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  fileName String @map("file_name")

  filePath String @map("file_path")

  fileSize Int? @map("file_size")

  @@map("chapter_previous_papers")
}
