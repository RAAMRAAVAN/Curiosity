{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next.config.ts", "app/(root)/consultants/DoctorsList.jsx", "app/(components)/Navbar/Navbar.jsx", "app/(root)/consultants/ConsultantsClient.jsx", "lib/fetchData.ts", "app/admin/ManageClasses/ManageSubjects/[classSlug]/layout.jsx", "app/(root)/layout.jsx", "app/(root)/courses/[classSlug]/layout.jsx", "app/(root)/courses/[classSlug]/home/Cources/[subject]/layout.jsx"],
  "exclude": ["node_modules"]
}
